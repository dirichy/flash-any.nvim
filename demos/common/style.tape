Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 36
Set Width 1920
Set Height 1080
Set Framerate 30
Set TypingSpeed 120ms
Set Margin 56
Set MarginFill "demos/common/backdrop.png"
Set WindowBar Colorful
Set WindowBarSize 40
Set BorderRadius 24
Set Padding 16
Set Theme "TokyoNight"
Set CursorBlink false

